# =============================================================================
# Docker Compose 환경 변수 설정
# =============================================================================
# 사용 방법: 이 파일을 .env로 복사하여 값을 설정하세요.
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Django 설정
# -----------------------------------------------------------------------------
# SECRET_KEY: Django secret key (필수)
# 생성 방법: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# DEBUG: Debug 모드 (기본값: False)
DEBUG=False

# ALLOWED_HOSTS: 허용된 Host 목록 (콤마로 구분)
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# -----------------------------------------------------------------------------
# PostgreSQL 설정
# -----------------------------------------------------------------------------
POSTGRES_DB=examonline
POSTGRES_USER=examuser
POSTGRES_PASSWORD=your-postgres-password-here

# POSTGRES_SSLMODE: SSL 모드 (Docker 환경에서는 설정하지 않음, Cloud 환경에서는 require)
# POSTGRES_SSLMODE=require

# -----------------------------------------------------------------------------
# MongoDB 설정
# -----------------------------------------------------------------------------
MONGODB_DATABASE=examonline_logs
MONGODB_USER=mongouser
MONGODB_PASSWORD=your-mongodb-password-here

# MONGODB_SSL: SSL 사용 여부 (Docker 환경: False, Cloud 환경: True)
# MONGODB_SSL=True
# MONGODB_SSL_CERT_REQS=CERT_REQUIRED

# -----------------------------------------------------------------------------
# Redis 설정
# -----------------------------------------------------------------------------
REDIS_PASSWORD=your-redis-password-here

# REDIS_SSL: SSL 사용 여부 (Docker 환경: False, Cloud 환경: True)
# REDIS_SSL=True
# REDIS_SSL_CERT_REQS=CERT_REQUIRED

# -----------------------------------------------------------------------------
# Frontend 설정
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1

# -----------------------------------------------------------------------------
# Gunicorn 설정 (선택)
# -----------------------------------------------------------------------------
# GUNICORN_WORKERS: Worker 프로세스 수 (기본값: 4)
# 권장: (2 * CPU_CORES) + 1
GUNICORN_WORKERS=4

# GUNICORN_THREADS: Worker당 Thread 수 (기본값: 2)
GUNICORN_THREADS=2
